# ─────────────────────────────────────────────────────────────────────────────
# Job Hunter Agent — environment configuration
# Copy this file to .env.local for local dev, and add the same keys in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
# The app RUNS WITHOUT any of these (sample data + heuristic scoring); each key
# below unlocks a real capability.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (required for real match scoring, cover letters, CV suggestions) ──
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional model overrides (sensible defaults are used if unset)
# ANTHROPIC_SCORING_MODEL=claude-sonnet-4-6
# ANTHROPIC_WRITING_MODEL=claude-opus-4-8

# ── Branding ──
# Shown in the dashboard title ("Job Hunter Agent for …"). Must be NEXT_PUBLIC_*
# to be readable by the browser.
NEXT_PUBLIC_APP_USER_NAME=Rémy Foulatier Gräfenstein

# ── Gmail (required only to create application drafts) ──
# 1. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
#    (type: Web application). Enable the Gmail API.
# 2. Add an authorised redirect URI matching GOOGLE_REDIRECT_URI below.
# 3. Run the app, visit /api/gmail/auth, consent, and copy the refresh token
#    shown by /api/gmail/callback into GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=your.email@gmail.com

# ── Scheduler (protects the /api/cron endpoint) ──
# Any random string. Use the SAME value as the GitHub Actions secret CRON_SECRET.
CRON_SECRET=

# ── Persistence (optional — survives across cron runs on Vercel) ──
# Create a Vercel KV (Upstash) store and paste its REST credentials here.
# Without these the app uses in-memory storage (fine for demos; resets on restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional: Welcome to the Jungle Algolia public key override ──
# WTTJ_ALGOLIA_KEY=
